# Copy this file to .env.local (never commit .env.local) and fill in the values.
# On the live host (for example Vercel), add the same variables in its Environment Variables settings.

# Resend API key from https://resend.com/api-keys
RESEND_API_KEY=

# Where CV emails are delivered. While no domain is verified in Resend, this must be the email address
# of the Resend account itself, because Resend's shared sender can only deliver to that address.
RESEND_TO_EMAIL=

# Optional. Leave empty to use Resend's shared sender, "Bell Recruitment <onboarding@resend.dev>".
# After verifying a domain in Resend, set an address on it, for example "Bell Recruitment <cv@yourdomain.com>".
RESEND_FROM=
