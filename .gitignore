# dependencies
node_modules/

# next.js
.next/
out/
next-env.d.ts
*.tsbuildinfo

# env: real keys live in .env.local (or the host's settings), never in Git. Only .env.example is committed.
.env
.env.*
!.env.example

# vercel
.vercel

# operating system and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/

# logs
*.log
npm-debug.log*

# form submissions (kept locally, never committed)
uploads/*
!uploads/.gitkeep
data/*
!data/.gitkeep
